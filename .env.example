APP_NAME=payment-transaction-service
APP_PORT=3001
APP_ENVIRONMENT=local

LOG_LEVEL=debug
LOG_FORMAT=console

DB_POSTGRES_WRITE_HOST=localhost
DB_POSTGRES_WRITE_PORT=5432
DB_POSTGRES_WRITE_USER=postgres
DB_POSTGRES_WRITE_PASSWORD=postgres
DB_POSTGRES_WRITE_NAME=payment_gateway
DB_POSTGRES_WRITE_SSL_MODE=disable

DB_POSTGRES_READ_HOST=localhost
DB_POSTGRES_READ_PORT=5432
DB_POSTGRES_READ_USER=postgres
DB_POSTGRES_READ_PASSWORD=postgres
DB_POSTGRES_READ_NAME=payment_gateway
DB_POSTGRES_READ_SSL_MODE=disable

TRACER_ENABLED=false

JWT_SECRET=change-me
JWT_TTL=24h

KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_DEPOSIT_CREATED=deposit.created
KAFKA_TOPIC_WITHDRAWAL_CREATED=withdrawal.created
KAFKA_WRITE_TIMEOUT=5s
KAFKA_PUBLISH_TIMEOUT=5s
KAFKA_ALLOW_AUTO_TOPIC_CREATION=true

PROMPTPAY_TARGET_TYPE=MOBILE
PROMPTPAY_TARGET=0812345678
PROMPTPAY_MERCHANT_NAME=PAYMENT GATEWAY
PROMPTPAY_MERCHANT_CITY=BANGKOK

TRANSACTION_MIN_DEPOSIT=100.00
TRANSACTION_MAX_DEPOSIT=1000000.00
TRANSACTION_MIN_WITHDRAWAL=100.00
TRANSACTION_MAX_WITHDRAWAL=500000.00
TRANSACTION_QR_EXPIRY=30m
TRANSACTION_ALLOWED_BANK_CODES=SCB,KTB,BAY,BBL
